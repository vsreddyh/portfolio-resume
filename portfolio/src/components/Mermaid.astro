---
interface Props {
  chart: string;
  label: string;
  caption?: string;
}

const { chart, label, caption = 'Diagram' } = Astro.props;
---
<figure class="diagram">
  <pre class="mermaid-diagram" data-chart={chart} role="img" aria-label={label} aria-busy="true">{chart}</pre>
  <figcaption data-mermaid-status>{caption}</figcaption>
  <noscript><p class="mono-label">Diagram source shown — enable JavaScript to render it.</p></noscript>
</figure>
<script is:inline>
  (function () {
    var SRC = 'https://cdn.jsdelivr.net/npm/mermaid@10.9.8/dist/mermaid.min.js';
    var INTEGRITY = 'sha384-N3QqR/7q+xm3BGX+CBbNI8AUmRRqcsDzToy+0z1NLDI0QmTKW8zvwLvqulJgk3dP';
    var SELECTOR = 'pre.mermaid-diagram:not([data-done])';
    var counter = 0;
    var pending = null;

    function setStatus(pre, text) {
      var fig = pre.closest('figure');
      var cap = fig && fig.querySelector('[data-mermaid-status]');
      if (cap) cap.textContent = text;
    }

    function failOne(pre) {
      pre.setAttribute('data-failed', 'true');
      pre.setAttribute('aria-busy', 'false');
      setStatus(pre, 'Diagram failed to load — source shown.');
    }

    function ensureLib(done) {
      if (window.mermaid) {
        done();
        return;
      }
      if (pending) {
        pending.push(done);
        return;
      }
      pending = [done];
      var flush = function () {
        var q = pending;
        pending = null;
        q.forEach(function (f) { f(); });
      };
      var s = document.createElement('script');
      s.src = SRC;
      s.defer = true;
      s.crossOrigin = 'anonymous';
      s.setAttribute('integrity', INTEGRITY);
      s.onload = flush;
      s.onerror = function () {
        pending = null;
        document.querySelectorAll(SELECTOR).forEach(failOne);
      };
      document.head.appendChild(s);
      // CDN blocked or too slow: stop leaving users on "Rendering…".
      setTimeout(function () {
        if (!window.mermaid && pending) {
          pending = null;
          document.querySelectorAll(SELECTOR).forEach(failOne);
        }
      }, 10000);
    }

    function palette() {
      if (document.documentElement.dataset.theme === 'dark') {
        return {
          background: '#161310',
          primaryColor: '#1e1a15',
          primaryTextColor: '#e9e2d3',
          primaryBorderColor: '#6b6046',
          secondaryColor: '#241f18',
          tertiaryColor: '#161310',
          lineColor: '#9a8d76',
          textColor: '#e9e2d3',
          mainBkg: '#1e1a15',
          nodeBorder: '#6b6046',
          clusterBkg: '#1e1a15',
          clusterBorder: '#4a4335',
          edgeLabelBackground: '#161310',
          titleColor: '#e9e2d3',
        };
      }
      return {
        background: '#f7f5f0',
        primaryColor: '#fffdf8',
        primaryTextColor: '#171512',
        primaryBorderColor: '#8a7f6b',
        secondaryColor: '#efeade',
        tertiaryColor: '#f7f5f0',
        lineColor: '#6d6558',
        textColor: '#171512',
        mainBkg: '#fffdf8',
        nodeBorder: '#8a7f6b',
        clusterBkg: '#fffdf8',
        clusterBorder: '#c9bfa9',
        edgeLabelBackground: '#f7f5f0',
        titleColor: '#171512',
      };
    }

    function initMermaid() {
      window.mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'ui-sans-serif, system-ui, sans-serif',
        flowchart: { curve: 'basis', htmlLabels: true, padding: 16 },
        themeVariables: Object.assign({ fontSize: '14px' }, palette()),
      });
    }

    function renderOne(pre) {
      try {
        var code = pre.getAttribute('data-chart') || pre.textContent;
        window.mermaid
          .render('mmd-' + counter++, code)
          .then(function (res) {
            pre.innerHTML = res.svg;
            pre.setAttribute('data-done', 'true');
            pre.setAttribute('aria-busy', 'false');
          })
          .catch(function () {
            failOne(pre);
          });
      } catch (e) {
        failOne(pre);
      }
    }

    function renderPending() {
      var nodes = document.querySelectorAll(SELECTOR);
      if (!nodes.length) return;
      if (!('IntersectionObserver' in window)) {
        ensureLib(function () {
          initMermaid();
          nodes.forEach(renderOne);
        });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            io.unobserve(entry.target);
            ensureLib(function () {
              initMermaid();
              renderOne(entry.target);
            });
          }
        });
      });
      nodes.forEach(function (n) { io.observe(n); });
    }

    renderPending();
    // Re-render finished diagrams when the theme flips so node fills and
    // edge labels follow the new palette. Not-yet-rendered diagrams pick it
    // up when they scroll into view.
    document.addEventListener('theme-change', function () {
      // CDN may have failed (failOne path) — then there is nothing to redraw.
      if (!window.mermaid) return;
      initMermaid();
      document.querySelectorAll(SELECTOR + ', pre.mermaid-diagram[data-done]').forEach(function (pre) {
        pre.removeAttribute('data-done');
        renderOne(pre);
      });
    });
  })();
</script>
