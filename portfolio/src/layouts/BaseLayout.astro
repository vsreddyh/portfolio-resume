---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL;
// pathname already includes `base` on GitHub Pages project sites, so resolve it
// against the configured site instead of a hardcoded origin.
const site = Astro.site ?? new URL('https://vsreddyh.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(`${base}og.png`, site).toString();
const {
  title = 'Vishnu Shouryan Reddy — Software Engineer',
  description = 'Full-stack software engineer: React, Node.js, Python, cloud, and AI-powered automation.',
} = Astro.props;

const nav = [
  { href: `${base}#work`, label: 'Work', id: 'work' },
  { href: `${base}#about`, label: 'About', id: 'about' },
  { href: `${base}#experience`, label: 'Experience', id: 'experience' },
  { href: `${base}#now`, label: 'Now', id: 'now' },
  { href: `${base}#contact`, label: 'Contact', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vishnu Shouryan Reddy — I build AI systems and full-stack products that survive production." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
    <noscript><style>.reveal{opacity:1 !important;transform:none !important}</style></noscript>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-emerald-400 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-zinc-950">Skip to content</a>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
        <a href={`${base}#home`} class="text-sm font-bold tracking-tight">
          vsreddyh<span class="text-emerald-400">.dev</span>
        </a>
        <div class="hidden items-center gap-6 text-sm text-zinc-300 md:flex">
          {nav.map((item) => (
            <a class="nav-link hover:text-white" data-spy={item.id} href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
        <div class="flex items-center gap-3">
          <a
            href={`${base}resume.pdf`}
            class="hidden rounded-full bg-emerald-400 px-4 py-1.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-300 md:inline-block"
          >
            Resume
          </a>
          <details class="relative md:hidden" data-menu>
            <summary class="cursor-pointer rounded-lg border border-white/15 px-3 py-1.5 text-sm list-none">
              Menu
            </summary>
            <div class="absolute right-0 mt-2 flex w-44 flex-col rounded-xl border border-white/10 bg-zinc-900 p-2 text-sm shadow-xl">
              {nav.map((item) => (
                <a class="rounded-lg px-3 py-2 hover:bg-white/10" href={item.href}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-white/10 py-8 text-center text-sm text-zinc-400">
      <p>© {new Date().getFullYear()} Vishnu Shouryan Reddy · Built with Astro · Hosted on GitHub Pages</p>
      <p class="mt-1">
        <a class="underline hover:text-white" href="https://github.com/vsreddyh">GitHub</a>
        {' · '}
        <a class="underline hover:text-white" href="https://linkedin.com/in/vsreddyh">LinkedIn</a>
      </p>
    </footer>

    <script>
      // Scrollspy + reveal. Re-runs after View Transition navigation.
      function init() {
        const links = document.querySelectorAll('[data-spy]');
        const sections = [...links]
          .map((a) => document.getElementById(a.getAttribute('data-spy') || ''))
          .filter(Boolean);

        // Mobile <details> menu: close it once a link is picked, and on Escape.
        document.querySelectorAll('[data-menu]').forEach((menu) => {
          menu.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => menu.removeAttribute('open')),
          );
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          document.querySelectorAll('[data-menu][open]').forEach((menu) =>
            menu.removeAttribute('open'),
          );
        });

        if ('IntersectionObserver' in window && sections.length > 0) {
          const spy = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  links.forEach((a) => {
                    const active = a.getAttribute('data-spy') === entry.target.id;
                    a.setAttribute('data-active', active ? 'true' : 'false');
                    if (active) a.setAttribute('aria-current', 'true');
                    else a.removeAttribute('aria-current');
                  });
                }
              }
            },
            { rootMargin: '-40% 0px -55% 0px' },
          );
          sections.forEach((s) => s && spy.observe(s));

          const revealer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 },
          );
          document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => revealer.observe(el));

          // Safety net: never leave content invisible if the observer never fires.
          setTimeout(() => {
            document
              .querySelectorAll('.reveal:not(.is-visible)')
              .forEach((el) => el.classList.add('is-visible'));
          }, 4000);
        } else {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        }
      }
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
