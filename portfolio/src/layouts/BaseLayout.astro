---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL;
// pathname already includes `base` on GitHub Pages project sites, so resolve it
// against the configured site instead of a hardcoded origin.
const site = Astro.site ?? new URL('https://vsreddyh.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(`${base}og.png`, site).toString();
const {
  title = 'Vishnu Shouryan Reddy — Software Engineer',
  description = 'Software engineer in Hyderabad. Go, Node, Python and Postgres, with the cron jobs and small services that keep them running.',
} = Astro.props;

const nav = [
  { href: `${base}#work`, label: 'Work', id: 'work' },
  { href: `${base}#about`, label: 'About', id: 'about' },
  { href: `${base}#experience`, label: 'Experience', id: 'experience' },
  { href: `${base}#now`, label: 'Now', id: 'now' },
  { href: `${base}#contact`, label: 'Contact', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#f7f5f0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vishnu Shouryan Reddy — software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper">Skip to content</a>
    <header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur-sm">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
        <a href={`${base}#home`} class="font-mono text-sm tracking-tight text-ink">
          vsreddyh<span class="text-rust">.dev</span>
        </a>
        <div class="hidden items-center gap-7 text-sm md:flex">
          {nav.map((item) => (
            <a class="nav-link" data-spy={item.id} href={item.href}>
              {item.label}
            </a>
          ))}
          <a href={`${base}resume.pdf`} class="text-ink underline decoration-rule underline-offset-4 transition hover:text-rust hover:decoration-rust">
            Résumé
          </a>
        </div>
        <details class="relative md:hidden" data-menu>
          <summary class="mono-label cursor-pointer list-none border border-rule px-3 py-1.5 text-ink">
            Menu
          </summary>
          <div class="absolute right-0 mt-2 flex w-48 flex-col border border-rule bg-paper-raised p-1 text-sm shadow-sm">
            {nav.map((item) => (
              <a class="px-3 py-2 text-ink-soft hover:bg-paper hover:text-ink" href={item.href}>
                {item.label}
              </a>
            ))}
            <a class="px-3 py-2 text-ink-soft hover:bg-paper hover:text-ink" href={`${base}resume.pdf`}>
              Résumé
            </a>
          </div>
        </details>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-muted sm:flex-row sm:items-baseline sm:justify-between">
        <p class="mono-label">© {new Date().getFullYear()} Vishnu Shouryan Reddy</p>
        <p class="mono-label flex gap-4">
          <a class="link" href="https://github.com/vsreddyh">GitHub</a>
          <a class="link" href="https://linkedin.com/in/vsreddyh">LinkedIn</a>
          <a class="link" href={`${base}resume.pdf`}>Résumé</a>
        </p>
      </div>
    </footer>

    <script>
      // Scrollspy for the section nav, plus closing the mobile menu after a pick.
      function init() {
        document.querySelectorAll('[data-menu]').forEach((menu) => {
          menu.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => menu.removeAttribute('open')),
          );
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          document.querySelectorAll('[data-menu][open]').forEach((menu) =>
            menu.removeAttribute('open'),
          );
        });

        const links = document.querySelectorAll('[data-spy]');
        const sections = [...links]
          .map((a) => document.getElementById(a.getAttribute('data-spy') || ''))
          .filter(Boolean);

        if (!('IntersectionObserver' in window) || sections.length === 0) return;

        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((a) => {
                const active = a.getAttribute('data-spy') === entry.target.id;
                a.setAttribute('data-active', active ? 'true' : 'false');
                if (active) a.setAttribute('aria-current', 'true');
                else a.removeAttribute('aria-current');
              });
            }
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        sections.forEach((s) => s && spy.observe(s));
      }
      init();
    </script>
  </body>
</html>
