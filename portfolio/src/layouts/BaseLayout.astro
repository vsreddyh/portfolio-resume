---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const base = import.meta.env.BASE_URL;
// pathname already includes `base` on GitHub Pages project sites, so resolve it
// against the configured site instead of a hardcoded origin.
const site = Astro.site ?? new URL('https://vsreddyh.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(`${base}og.png`, site).toString();
const {
  title = 'Vishnu Shouryan Reddy — Software Engineer',
  description = 'Software engineer in Hyderabad. Go, Node, Python and Postgres, with the cron jobs and small services that keep them running.',
  ogType = 'website',
} = Astro.props;

const nav = [
  { href: `${base}#about`, label: 'About me', id: 'about' },
  { href: `${base}#experience`, label: 'Experience', id: 'experience' },
  { href: `${base}#skills`, label: 'Skills', id: 'skills' },
  { href: `${base}#now`, label: 'Now', id: 'now' },
  { href: `${base}#work`, label: 'Projects', id: 'work' },
  { href: `${base}#contact`, label: 'Contact', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#f7f5f0" id="theme-color" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash. Saved choice wins,
      // then the OS preference, then light.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.dataset.theme = 'dark';
            var meta = document.getElementById('theme-color');
            if (meta) meta.setAttribute('content', '#161310');
          }
        } catch (e) { /* private mode: stay light */ }
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vishnu Shouryan Reddy — software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper">Skip to content</a>
    <header class="site-header sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur-sm">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
        <a href={`${base}#home`} class="inline-flex min-h-[44px] items-center font-mono text-sm tracking-tight text-ink">
          vsreddyh
        </a>
        <div class="hidden items-center gap-6 text-[0.9375rem] md:flex">
          {nav.map((item) => (
            <a class="nav-link" data-spy={item.id} href={item.href}>
              {item.label}
            </a>
          ))}
          <a
            href={`${base}resume.pdf`}
            class="inline-flex min-h-[44px] items-center px-1 text-ink underline decoration-rule underline-offset-4 transition hover:text-rust hover:decoration-rust"
          >
            Resume
          </a>
        </div>
        <div class="flex items-center gap-3">
        <button
          type="button"
          data-theme-toggle
          class="mono-label flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center border border-rule px-2.5 py-1.5 text-ink transition hover:text-rust"
          aria-label="Toggle dark theme"
          aria-pressed="false"
        >
          <span data-theme-icon-moon>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
          <span data-theme-icon-sun class="hidden">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </span>
        </button>
        <details class="relative md:hidden" data-menu>
          <summary
            class="mono-label inline-flex min-h-[44px] cursor-pointer list-none items-center border border-rule px-3 py-1.5 text-ink"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            Menu
          </summary>
          <div id="mobile-menu" class="absolute right-0 mt-2 flex w-48 flex-col border border-rule bg-paper-raised p-1 text-sm shadow-sm">
            {nav.map((item) => (
              <a class="flex min-h-[44px] items-center px-3 text-ink-soft hover:bg-paper hover:text-ink" href={item.href}>
                {item.label}
              </a>
            ))}
            <a class="flex min-h-[44px] items-center px-3 text-ink-soft hover:bg-paper hover:text-ink" href={`${base}resume.pdf`}>
              Resume
            </a>
          </div>
        </details>
        </div>
      </nav>
      <div class="scroll-progress" data-progress aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-muted sm:flex-row sm:items-baseline sm:justify-between">
        <p class="mono-label">© {new Date().getFullYear()} Vishnu Shouryan Reddy</p>
        <p class="mono-label flex gap-4">
          <a class="link" href="https://github.com/vsreddyh"><svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="mr-1 inline-block align-[-2px]"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a>
          <a class="link" href="https://linkedin.com/in/vsreddyh"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mr-1 inline-block align-[-2px]"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>LinkedIn</a>
          <a class="link" href={`${base}resume.pdf`}>Resume</a>
        </p>
      </div>
    </footer>

    <button
      type="button"
      data-to-top
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-50 hidden h-11 w-11 items-center justify-center border border-rule bg-paper text-lg text-ink shadow-sm transition hover:text-rust"
    >
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      // Theme toggle. The head script already set the initial theme; here we
      // sync the icon and wire the button. Diagrams listen for theme-change.
      function syncThemeIcon() {
        var dark = document.documentElement.dataset.theme === 'dark';
        document.querySelectorAll('[data-theme-icon-moon]').forEach((el) =>
          el.classList.toggle('hidden', dark),
        );
        document.querySelectorAll('[data-theme-icon-sun]').forEach((el) =>
          el.classList.toggle('hidden', !dark),
        );
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        });
      }
      function setTheme(theme) {
        if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
        else delete document.documentElement.dataset.theme;
        try {
          localStorage.setItem('theme', theme);
        } catch (e) { /* private mode */ }
        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#161310' : '#f7f5f0');
        syncThemeIcon();
        document.dispatchEvent(new CustomEvent('theme-change'));
      }
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () =>
          setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'),
        ),
      );
      syncThemeIcon();

      // Scrollspy for the section nav, plus closing the mobile menu after a pick.
      function init() {
        // Header: transparent only over the hero photo (home page top).
        // Other pages have no photo behind the bar, so they keep it solid.
        const header = document.querySelector('.site-header');
        const heroPhoto = document.querySelector('#home .hero-photo');
        const syncHeader = () => {
          if (header) header.classList.toggle('is-top', !!heroPhoto && window.scrollY < 24);
        };
        // Real header height into a CSS var so the photo overlay never
        // assumes h-16 (wrap/zoom safe), with a 4rem fallback.
        const syncHeaderH = () => {
          if (header) document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
        };
        window.addEventListener('scroll', syncHeader, { passive: true });
        // ResizeObserver catches everything that changes bar height: menu
        // toggle, font load, zoom, viewport resize.
        if ('ResizeObserver' in window && header) {
          new ResizeObserver(syncHeaderH).observe(header);
        } else {
          window.addEventListener('resize', syncHeaderH);
        }
        syncHeader(); syncHeaderH();
        // Back-to-top button: hidden until the user scrolls down.
        const toTop = document.querySelector('[data-to-top]');
        const toggleToTop = () => {
          if (!toTop) return;
          const show = window.scrollY > 600;
          toTop.classList.toggle('hidden', !show);
          toTop.classList.toggle('flex', show);
        };
        // Native scroll only: no custom scroll container exists (the skill
        // canvas and hero use overflow-hidden decoratively; code blocks use
        // overflow-x). window.scrollTo lands synchronously.
        const smoothOk = () => !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (toTop) {
          toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: smoothOk() ? 'smooth' : 'auto' }));
          window.addEventListener('scroll', toggleToTop, { passive: true });
          toggleToTop();
        }
        // Mobile nav: a non-modal disclosure, so no focus trap — Esc closes
        // and returns focus to the summary, and outside taps close it.
        // aria-expanded is synced both on `toggle` (user interaction) and
        // explicitly on programmatic closes, so it never goes stale.
        const closeMenu = (menu) => {
          if (!menu.hasAttribute('open')) return;
          menu.removeAttribute('open');
          const summary = menu.querySelector('summary');
          if (summary) summary.setAttribute('aria-expanded', 'false');
        };
        document.querySelectorAll('[data-menu]').forEach((menu) => {
          const summary = menu.querySelector('summary');
          const sync = () => summary && summary.setAttribute('aria-expanded', menu.hasAttribute('open') ? 'true' : 'false');
          menu.addEventListener('toggle', sync);
          sync();
          menu.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => closeMenu(menu)),
          );
        });
        document.addEventListener('pointerdown', (e) => {
          document.querySelectorAll('[data-menu][open]').forEach((menu) => {
            if (menu.contains(e.target)) return;
            closeMenu(menu);
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          document.querySelectorAll('[data-menu][open]').forEach((menu) => {
            closeMenu(menu);
            const summary = menu.querySelector('summary');
            if (summary) summary.focus();
          });
        });

        // Reading progress: one hairline under the header.
        const bar = document.querySelector('[data-progress]');
        let ticking = false;
        const paintProgress = () => {
          ticking = false;
          if (!bar) return;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          bar.style.transform = `scaleX(${p})`;
        };
        if (bar) {
          window.addEventListener('scroll', () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(paintProgress);
          }, { passive: true });
          window.addEventListener('resize', paintProgress, { passive: true });
          paintProgress();
        }

        // Reveal below-the-fold blocks, never the first screen. Off entirely
        // for readers who ask for reduced motion.
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ('IntersectionObserver' in window && !reduced) {
          const items = [...document.querySelectorAll('[data-reveal]')].filter(
            (el) => el.getBoundingClientRect().top > window.innerHeight,
          );
          const ro = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                ro.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
          );
          items.forEach((el) => {
            el.classList.add('will-reveal');
            ro.observe(el);
          });
          // Full-page captures, print, and slow observers must never leave
          // sections hidden: reveal everything before printing, and force any
          // stragglers visible shortly after load. The script can execute
          // after `load` already fired, so check readyState first.
          const revealAll = () => {
            document.querySelectorAll('.will-reveal:not(.is-in)').forEach((el) => {
              el.classList.add('is-in');
              ro.unobserve(el);
            });
          };
          window.addEventListener('beforeprint', revealAll);
          if (document.readyState === 'complete') setTimeout(revealAll, 2500);
          else window.addEventListener('load', () => setTimeout(revealAll, 2500), { once: true });
        }

        const links = document.querySelectorAll('[data-spy]');
        const sections = [...links]
          .map((a) => document.getElementById(a.getAttribute('data-spy') || ''))
          .filter(Boolean);

        if (!('IntersectionObserver' in window) || sections.length === 0) return;

        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((a) => {
                const active = a.getAttribute('data-spy') === entry.target.id;
                a.setAttribute('data-active', active ? 'true' : 'false');
                if (active) a.setAttribute('aria-current', 'true');
                else a.removeAttribute('aria-current');
              });
            }
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        sections.forEach((s) => s && spy.observe(s));
      }
      init();
    </script>
  </body>
</html>
