---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'Vishnu Shouryan Reddy — Software Engineer',
  description = 'Full-stack software engineer: React, Node.js, Python, cloud, and AI-powered automation.',
} = Astro.props;

const nav = [
  { href: `${base}#about`, label: 'About', id: 'about' },
  { href: `${base}#experience`, label: 'Experience', id: 'experience' },
  { href: `${base}#projects`, label: 'Projects', id: 'projects' },
  { href: `${base}#skills`, label: 'Skills', id: 'skills' },
  { href: `${base}#resume`, label: 'Resume', id: 'resume' },
  { href: `${base}#contact`, label: 'Contact', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
        <a href={`${base}#home`} class="text-sm font-bold tracking-tight">
          vsreddyh<span class="text-emerald-400">.dev</span>
        </a>
        <div class="hidden items-center gap-6 text-sm text-zinc-300 md:flex">
          {nav.map((item) => (
            <a class="nav-link hover:text-white" data-spy={item.id} href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
        <div class="flex items-center gap-3">
          <a
            href={`${base}#contact`}
            class="hidden rounded-full bg-emerald-400 px-4 py-1.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-300 md:inline-block"
          >
            Hire me
          </a>
          <details class="relative md:hidden">
            <summary class="cursor-pointer rounded-lg border border-white/15 px-3 py-1.5 text-sm list-none">
              Menu
            </summary>
            <div class="absolute right-0 mt-2 flex w-44 flex-col rounded-xl border border-white/10 bg-zinc-900 p-2 text-sm shadow-xl">
              {nav.map((item) => (
                <a class="rounded-lg px-3 py-2 hover:bg-white/10" href={item.href}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/10 py-8 text-center text-sm text-zinc-400">
      <p>© {new Date().getFullYear()} Vishnu Shouryan Reddy · Built with Astro · Hosted on GitHub Pages</p>
      <p class="mt-1">
        <a class="underline hover:text-white" href="https://github.com/vsreddyh">GitHub</a>
        {' · '}
        <a class="underline hover:text-white" href="https://linkedin.com/in/vsreddyh">LinkedIn</a>
      </p>
    </footer>

    <script>
      // Scrollspy + reveal. Re-runs after View Transition navigation.
      function init() {
        const links = document.querySelectorAll('[data-spy]');
        const sections = [...links]
          .map((a) => document.getElementById(a.getAttribute('data-spy') || ''))
          .filter(Boolean);

        if ('IntersectionObserver' in window && sections.length > 0) {
          const spy = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  links.forEach((a) =>
                    a.setAttribute(
                      'data-active',
                      a.getAttribute('data-spy') === entry.target.id ? 'true' : 'false',
                    ),
                  );
                }
              }
            },
            { rootMargin: '-40% 0px -55% 0px' },
          );
          sections.forEach((s) => s && spy.observe(s));

          const revealer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 },
          );
          document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => revealer.observe(el));
        } else {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        }
      }
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
