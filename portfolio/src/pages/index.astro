---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillField from '../components/SkillField.astro';
import { projectContext } from '../lib/project-meta';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);

const stats = [
  { value: String(all.length).padStart(2, '0'), label: 'projects in the index' },
  { value: '06', label: 'MCP servers I run' },
  { value: '02', label: 'engineers led' },
];

const now = [
  {
    title: 'Agento',
    status: 'running',
    href: `${base}projects/agento/`,
    note: 'Daily driver: Compose client, Go API on one box, six MCP servers in T3 Code.',
  },
];
---
<BaseLayout>
  <section id="home" class="relative overflow-hidden">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-20 sm:pt-28">
      <p class="section-kicker">Software engineer · Hyderabad</p>
      <h1 class="mt-5 max-w-4xl text-[clamp(2.6rem,6.5vw,4.75rem)] leading-[1.02] tracking-[-0.02em]">
        Vishnu Shouryan Reddy
      </h1>
      <p class="mt-6 max-w-[34rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
        I build the services, clients and cron jobs that keep a product running
        without me — and I write down what each system still gets wrong.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn btn-solid">
          See the work <span aria-hidden="true">↓</span>
        </a>
        <a href={`${base}resume.pdf`} class="btn" download="Vishnu-Shouryan-Reddy-Resume.pdf">
          Résumé (PDF)
        </a>
        <a href="mailto:shouryanreddyh@gmail.com" class="btn">Email</a>
      </div>
      <ul class="mt-14 grid max-w-2xl grid-cols-3 gap-x-6 gap-y-4 border-t border-rule pt-6">
        {stats.map((s) => (
          <li>
            <span class="stat-value block">{s.value}</span>
            <span class="mono-label mt-2 block">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="about" class="border-t border-rule bg-paper-raised">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]" data-reveal>
      <div>
        <p class="section-kicker">01</p>
        <h2 class="mt-3 text-2xl">About me</h2>
      </div>
      <div class="max-w-[36rem] space-y-4 text-[1.0625rem] leading-[1.7] text-ink-soft">
        <p>
          I’m based in Hyderabad, and I studied computer science at KMIT
          (2022–2026).
        </p>
        <p>
          I’m a software engineer at 5th Bridge Data Technologies. I design and
          build apps, APIs, and the orchestration that runs them. Most of my
          work is backend: Go, Node, and Python services on Postgres,
          ClickHouse, and MongoDB, plus the frontend to ship the whole thing
          myself. I take products from idea to production.
        </p>
        <p>
          Have a look at my <a class="link" href={`${base}resume.pdf`} download="Vishnu-Shouryan-Reddy-Resume.pdf">Resume</a> <span aria-hidden="true">↓</span>
        </p>
      </div>
    </div>
  </section>

  <section id="experience" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
      <p class="section-kicker">02</p>
      <h2 class="mt-3 text-3xl">Experience</h2>
      <div class="mt-8 border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-ink">Software Engineer — 5th Bridge Data Technologies</h3>
          <span class="mono-label">Jun 2026 – present</span>
        </div>
        <ul class="mt-3 max-w-[38rem] list-disc space-y-1.5 pl-5 text-[0.9375rem] leading-relaxed text-ink-soft">
          <li>Built <a class="link" href="https://ohfluence.com">Ohfluence</a>, a role-based platform for social media advertising agencies (React, Node.js, Convex), from campaign creation to influencer offer distribution.</li>
          <li>Built AI content tools (React, Node.js, SQLite) as internal products: a trending reel-idea generator over live news plus an LLM, and a cost-optimized text-to-video pipeline.</li>
          <li>Extended ProCAD (Revalize) with User and Domain Extensions shipped to enterprise customers.</li>
          <li>Led 2 interns on event-driven trading infrastructure (Node.js, ClickHouse, Postgres) for real-time market alerts and order execution.</li>
        </ul>
      </div>
      <div class="mt-8 border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-ink">Software Engineer Intern — 5th Bridge Data Technologies</h3>
          <span class="mono-label">Jan 2026 – Jun 2026</span>
        </div>
        <ul class="mt-3 max-w-[38rem] list-disc space-y-1.5 pl-5 text-[0.9375rem] leading-relaxed text-ink-soft">
          <li>Predictive models in Python (scikit-learn, Pandas) with simulation and backtesting, paired with rule-based approaches.</li>
          <li>An NLP pipeline in PyTorch and Transformers that pulls insights out of unstructured text.</li>
          <li>An LLM-plus-search layer that verifies signals for spotting emerging trends in live data streams.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="skills" class="border-y border-rule bg-paper-sunk">
    <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
      <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
        <div>
          <p class="section-kicker">03</p>
          <h2 class="mt-3 text-3xl">Skills</h2>
          <p class="mt-3 max-w-[34rem] text-sm leading-relaxed text-ink-soft">
            The list shows every category. The map is the same set of skills as
            a draggable field — grab a pill, throw it, ⌘/Ctrl-scroll to zoom.
          </p>
        </div>
        <div class="flex gap-1" data-skill-mode>
          <button type="button" data-skill-view="simple" aria-pressed="true" class="mono-label min-h-[44px] border border-rule bg-paper px-3 py-1">List</button>
          <button type="button" data-skill-view="visual" aria-pressed="false" class="mono-label min-h-[44px] border border-rule bg-paper px-3 py-1">Map</button>
        </div>
      </div>
      <SkillField />
    </div>
  </section>

  <section id="now" class="border-t border-rule">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]" data-reveal>
      <div>
        <p class="section-kicker">04</p>
        <h2 class="mt-3 text-2xl">Now</h2>
      </div>
      <ul class="max-w-[36rem] divide-y divide-rule">
        {now.map((item) => (
          <li class="py-4 first:pt-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <a class="link font-medium" href={item.href}>{item.title}</a>
              <span class="mono-label">{item.status}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-muted">{item.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="border-t border-rule bg-paper-raised">
    <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
      <p class="section-kicker">05</p>
      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-3xl">Projects</h2>
        <p class="mono-label">Three featured · the rest in the index</p>
      </div>

      <div class="mt-10">
        {featured.map((p, i) => (
          <a href={`${base}projects/${p.id}/`} class="row" aria-label={p.data.title}>
            <span class="mono-label">0{i + 1}</span>
            <span>
              <span class="row-title block text-2xl leading-snug">{p.data.title}</span>
              <span class="mt-1 block max-w-xl text-sm leading-relaxed text-muted">{p.data.description}</span>
              <span class="mono-label mt-2 block">{projectContext(p.data)} · {p.data.stack.slice(0, 3).join(' · ')}</span>
            </span>
            <span class="row-arrow text-right" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <p class="mt-10 text-sm">
        <a class="link" href={`${base}projects/`}>All {all.length} projects <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section id="contact" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20" data-reveal>
      <div class="border border-rule bg-paper-raised p-6 sm:p-10">
        <p class="section-kicker">06</p>
        <h2 class="mt-3 text-3xl">Get in touch</h2>
        <p class="mt-4 max-w-[34rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
          Open to software engineering roles. Email is fastest.
        </p>
        <p class="mt-6">
          <a
            class="text-[clamp(1.35rem,3vw,2rem)] leading-tight text-ink underline decoration-rule decoration-1 underline-offset-4 transition hover:text-rust hover:decoration-rust"
            href="mailto:shouryanreddyh@gmail.com"
          >
            shouryanreddyh@gmail.com
          </a>
        </p>
        <p class="mono-label mt-8 flex flex-wrap gap-x-6 gap-y-2">
          <a class="link" href="https://github.com/vsreddyh">GitHub ↗</a>
          <a class="link" href="https://linkedin.com/in/vsreddyh">LinkedIn ↗</a>
          <a class="link" href={`${base}resume.pdf`}>Résumé (PDF)</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
