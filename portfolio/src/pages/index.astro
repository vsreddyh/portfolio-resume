---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillField from '../components/SkillField.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);

const now = [
  {
    title: 'Agento',
    status: 'running',
    href: `${base}projects/agento/`,
    note: 'Daily driver: Compose client, Go API on one box, six MCP servers in T3 Code.',
  },
];
---
<BaseLayout>
  <section id="home" class="mx-auto max-w-6xl px-6 pb-24 pt-20 sm:pt-28">
    <p class="mono-label">Vishnu Shouryan Reddy · Software engineer, Hyderabad</p>
    <h1 class="mt-6 max-w-4xl text-[clamp(2.6rem,6.5vw,4.75rem)] leading-[1.02] tracking-[-0.02em]">
      I build products, not projects.
    </h1>
    <p class="mt-7 max-w-[36rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
      I'm a software engineer at 5th Bridge Data Technologies. I design, build,
      and run complete products: apps, APIs, and the orchestration
      that runs them. Most of my work is backend: Go, Node, and Python services
      on Postgres, ClickHouse, and MongoDB, plus the frontend to ship the
      whole thing myself. I take products from idea to production.
    </p>
  </section>

  <section id="work" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-3xl">My Top Three Works</h2>
      </div>

      <div class="mt-10">
        {featured.map((p, i) => (
          <a href={`${base}projects/${p.id}/`} class="row">
            <span class="mono-label">0{i + 1}</span>
            <span>
              <span class="row-title block text-2xl leading-snug">{p.data.title}</span>
              <span class="mt-1 block max-w-xl text-sm leading-relaxed text-muted">{p.data.description}</span>
            </span>
            <span class="mono-label hidden text-right sm:block">{p.data.stack.slice(0, 3).join(' · ')}</span>
            <span class="row-arrow text-right" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <p class="mt-10 text-sm">
        <a class="link" href={`${base}projects/`}>All projects <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section id="about" class="border-t border-rule bg-paper-raised/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]">
      <h2 class="text-2xl">About</h2>
      <div class="max-w-[36rem] space-y-4 text-[1.0625rem] leading-[1.7] text-ink-soft">
        <p>
          I’m a software engineer working in Hyderabad, currently at 5th Bridge Data
          Technologies. I studied computer science at KMIT (2022–2026).
        </p>
        <p>
          I like owning the whole thing: the app, the API, and everything it
          runs on. The projects on this page are ones I use myself - my tasks
          and health live in Agento, my verse-a-day arrives as a scheduled
          thread, my game questions go to a bot I wrote. If I’m not running
          it, I’m not shipping it.
        </p>
      </div>
  </div>
</section>

  <section id="skills" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-3xl">Skills</h2>
        <div class="flex gap-1" data-skill-mode>
          <button type="button" data-skill-view="simple" class="mono-label border border-rule px-2 py-1">Simple</button>
          <button type="button" data-skill-view="visual" class="mono-label border border-rule px-2 py-1">Visual</button>
        </div>
      </div>
      <SkillField />
    </div>
  </section>

  <section id="experience" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl">Experience</h2>
      <div class="mt-8 border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-ink">Software Engineer — 5th Bridge Data Technologies</h3>
          <span class="mono-label">Jun 2026 – present</span>
        </div>
        <p class="mt-3 max-w-[38rem] text-[0.9375rem] leading-relaxed text-ink-soft">
          I work at 5th Bridge Data Technologies.
        </p>
      </div>
      <div class="mt-8 border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-ink">Software Engineer Intern — 5th Bridge Data Technologies</h3>
          <span class="mono-label">Jan 2026 – Jun 2026</span>
        </div>
        <p class="mt-3 max-w-[38rem] text-[0.9375rem] leading-relaxed text-ink-soft">
          Machine learning and NLP prototypes: predictive models, text pipelines, and trend detection.
        </p>
      </div>
    </div>
  </section>

  <section id="resume" class="border-t border-rule bg-paper-raised/60">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl">Résumé</h2>
      <p class="mt-4 max-w-[34rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
        Full history and education, as a PDF.
      </p>
      <p class="mt-6">
        <a class="btn" href={`${base}resume.pdf`}>Download résumé <span aria-hidden="true">↓</span></a>
      </p>
    </div>
  </section>

  <section id="now" class="border-t border-rule bg-paper-raised/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]">
      <h2 class="text-2xl">Now</h2>
      <ul class="max-w-[36rem] divide-y divide-rule">
        {now.map((item) => (
          <li class="py-4 first:pt-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <a class="link font-medium" href={item.href}>{item.title}</a>
              <span class="mono-label">{item.status}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-muted">{item.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl">Get in touch</h2>
      <p class="mt-4 max-w-[34rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
        Open to software engineering roles.
      </p>
      <p class="mt-6">
        <a
          class="text-[clamp(1.35rem,3vw,2rem)] leading-tight text-ink underline decoration-rule decoration-1 underline-offset-4 transition hover:text-rust hover:decoration-rust"
          href="mailto:shouryanreddyh@gmail.com"
        >
          shouryanreddyh@gmail.com
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
