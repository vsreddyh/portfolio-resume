---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const archive = (await getCollection('projects'))
  .filter((p) => !p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <!-- HERO: thesis, not summary -->
  <section id="home" class="mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-center px-4 pt-24 sm:px-6">
    <p class="reveal text-sm font-semibold uppercase tracking-widest text-emerald-400">
      Vishnu Shouryan Reddy · Software Engineer @ 5th Bridge
    </p>
    <h1 class="reveal mt-4 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl" style="--reveal-delay:80ms">
      I build AI systems and full-stack products that survive production.
    </h1>
    <p class="reveal mt-5 max-w-2xl text-lg text-zinc-300" style="--reveal-delay:160ms">
      From a six-agent Discord fleet with automatic LLM failover, to a media pipeline
      engineered to cut cloud bills — I care about systems that are cheap to run and
      easy to reason about.
    </p>
    <div class="reveal mt-8 flex flex-wrap gap-3" style="--reveal-delay:240ms">
      <a href="#work" class="rounded-full bg-emerald-400 px-6 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-300">
        Selected work
      </a>
      <a href="https://github.com/vsreddyh" class="rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold transition hover:border-white/50 hover:bg-white/5">
        GitHub
      </a>
      <a href="#contact" class="rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold transition hover:border-white/50 hover:bg-white/5">
        Get in touch
      </a>
    </div>
  </section>

  <!-- SELECTED WORK: 3 deep, rest archived -->
  <section id="work" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Selected work</h2>
        <p class="mt-2 max-w-xl text-zinc-400">
          Three projects that show how I think — each one a full case study.
        </p>
      </div>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {featured.map((p, i) => (
        <a
          href={`${base}projects/${p.id}/`}
          class="reveal group flex flex-col rounded-2xl border border-white/10 bg-zinc-900/60 p-6 transition hover:-translate-y-1 hover:border-emerald-400/50"
          style={`--reveal-delay:${Math.min(i, 5) * 70}ms`}
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">{p.data.kicker}</p>
          <h3 class="mt-2 text-xl font-bold group-hover:text-emerald-300">{p.data.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{p.data.description}</p>
          <p class="mt-3 text-sm font-semibold text-zinc-200">→ {p.data.outcome}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {p.data.stack.slice(0, 4).map((s) => (
              <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-xs text-zinc-300">{s}</span>
            ))}
          </div>
          <span class="mt-4 text-sm font-semibold text-emerald-400">Read the case study →</span>
        </a>
      ))}
    </div>

    <div class="reveal mt-10 rounded-2xl border border-white/10 p-6">
      <h3 class="text-sm font-semibold uppercase tracking-widest text-zinc-400">More projects</h3>
      <ul class="mt-3 divide-y divide-white/5 text-sm">
        {archive.map((p) => (
          <li>
            <a href={`${base}projects/${p.id}/`} class="flex flex-wrap items-baseline justify-between gap-2 py-2.5 transition hover:text-emerald-300">
              <span class="font-medium">{p.data.title}</span>
              <span class="text-zinc-500">{p.data.description}</span>
            </a>
          </li>
        ))}
        <li class="py-2.5 text-zinc-500">
          Plus CLI games, a bash hardware monitor, placement-data tooling and more —
          <a href="https://github.com/vsreddyh?tab=repositories" class="font-medium text-emerald-400 hover:text-emerald-300">everything lives on GitHub ↗</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ABOUT: voice, not summary -->
  <section id="about" class="border-y border-white/10 bg-zinc-900/40">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="reveal text-2xl font-bold tracking-tight sm:text-3xl">About</h2>
      <div class="reveal mt-4 max-w-3xl space-y-4 text-zinc-300" style="--reveal-delay:100ms">
        <p>
          I'm a software engineer in Hyderabad working across the stack — React and
          Node on the frontend-facing side, Python/Go/FastAPI and Postgres-flavoured
          infrastructure underneath, with a growing obsession for agentic AI that
          actually runs reliably outside a demo.
        </p>
        <p>
          My bias is toward boring operations: Docker Compose over bespoke platforms,
          nightly batch jobs over always-on spend, SQLite and Postgres before exotic
          stores. Most of my side projects are experiments in how much can run
          unattended — retention jobs, cron syncs, self-hosted search — without me
          babysitting them.
        </p>
        <p>
          Currently a Software Engineer at 5th Bridge Data Technologies, and a B.Tech
          CSE student at KMIT (2022–2026). When I'm not shipping, I'm usually
          automating something in my own setup that didn't need automating.
        </p>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE: compressed, resume holds details -->
  <section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="reveal text-2xl font-bold tracking-tight sm:text-3xl">Experience</h2>
    <div class="mt-8 space-y-4">
      <article class="reveal rounded-2xl border border-white/10 bg-zinc-900/60 p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold">Software Engineer — 5th Bridge Data Technologies</h3>
          <span class="text-sm text-zinc-400">Jun 2026 – Present</span>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-zinc-300">
          Leading a small team on event-driven trading infrastructure (Node.js,
          ClickHouse, PostgreSQL) while shipping an influencer-marketing platform and
          AI content tooling. Details and earlier intern work (ML models, NLP
          pipelines, trend detection) are in the resume.
        </p>
      </article>
      <p class="reveal text-sm text-zinc-400" style="--reveal-delay:80ms">
        Full history, education and certifications →
        <a href={`${base}resume.pdf`} class="font-medium text-emerald-400 hover:text-emerald-300">Main resume (PDF)</a>
      </p>
    </div>
  </section>

  <!-- NOW: a resume can't have this -->
  <section id="now" class="border-y border-white/10 bg-zinc-900/40">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="reveal text-2xl font-bold tracking-tight sm:text-3xl">Now</h2>
      <ul class="reveal mt-6 max-w-3xl list-disc space-y-2 pl-5 text-zinc-300" style="--reveal-delay:100ms">
        <li>Building a personal agentic AI ecosystem — multi-agent orchestration over Discord with self-hosted search and LLM failover.</li>
        <li>Growing <span class="font-medium text-zinc-100">Saanjh Sahayak</span>, a clinical-decision mobile app with on-device-friendly AI report review.</li>
        <li>Shipping <span class="font-medium text-zinc-100">Daily Gita</span>, a fully offline multilingual verse app (expo-sqlite, no backend).</li>
      </ul>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="reveal rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-emerald-400/10 to-transparent p-8 text-center sm:p-12">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Let's talk</h2>
      <p class="mx-auto mt-3 max-w-xl text-zinc-300">
        Open to software engineering roles — especially teams shipping AI-powered
        products or event-driven systems. Email is fastest.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="mailto:shouryanreddyh@gmail.com" class="rounded-full bg-emerald-400 px-6 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-emerald-300">
          shouryanreddyh@gmail.com
        </a>
        <a href="https://linkedin.com/in/vsreddyh" class="rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold transition hover:border-white/50 hover:bg-white/5">
          LinkedIn
        </a>
        <a href={`${base}resume.pdf`} class="rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold transition hover:border-white/50 hover:bg-white/5">
          Resume (PDF)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
