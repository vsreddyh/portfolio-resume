---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const archive = all.filter((p) => !p.data.featured).sort((a, b) => a.data.order - b.data.order);

const now = [
  {
    title: 'Agento',
    status: 'running',
    href: `${base}projects/agento/`,
    note: 'Daily driver: Compose client, Go API on one box, six MCP servers in T3 Code.',
  },
  {
    title: 'Daily Gita',
    status: 'daily',
    href: `${base}projects/daily-gita/`,
    note: 'A scheduled task fetches a verse from the internet every day and opens a thread on it.',
  },
  {
    title: 'Schedio',
    status: 'live',
    href: `${base}projects/schedio/`,
    note: 'Student–college–recruiter platform, running demo linked on its page.',
  },
];
---
<BaseLayout>
  <section id="home" class="mx-auto max-w-6xl px-6 pb-24 pt-20 sm:pt-28">
    <p class="mono-label">Vishnu Shouryan Reddy · Software engineer, Hyderabad</p>
    <h1 class="mt-6 max-w-4xl text-[clamp(2.4rem,6vw,4.25rem)] leading-[1.02] tracking-[-0.02em]">
      I build products, not projects.
    </h1>
    <p class="mt-7 max-w-[36rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
      I'm a software engineer at 5th Bridge Data Technologies. I design, build,
      and run complete products end to end — apps, APIs, and the infrastructure
      behind them. Selected work is below, each with how it is built.
    </p>
    <div class="mt-9 flex flex-wrap items-baseline gap-x-7 gap-y-3">
      <a href="#work" class="btn">Selected work <span aria-hidden="true">↓</span></a>
      <a href="https://github.com/vsreddyh" class="btn">GitHub <span aria-hidden="true">↗</span></a>
      <a href="mailto:shouryanreddyh@gmail.com" class="btn">Email</a>
    </div>
  </section>

  <section id="work" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-3xl">Selected work</h2>
        <p class="mono-label">Three systems · architecture diagrams</p>
      </div>

      <div class="mt-10">
        {featured.map((p, i) => (
          <a href={`${base}projects/${p.id}/`} class="row">
            <span class="mono-label">0{i + 1}</span>
            <span>
              <span class="row-title block text-2xl leading-snug">{p.data.title}</span>
              <span class="mt-1 block max-w-xl text-sm leading-relaxed text-muted">{p.data.description}</span>
            </span>
            <span class="mono-label hidden text-right sm:block">{p.data.stack.slice(0, 3).join(' · ')}</span>
            <span class="row-arrow text-right" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <div class="mt-16 grid gap-x-12 sm:grid-cols-2">
        {archive.map((p) => (
          <a href={`${base}projects/${p.id}/`} class="archive-row block border-t border-rule px-1 py-4 no-underline">
            <span class="flex items-baseline justify-between gap-4">
              <span class="archive-title text-[0.9375rem] text-ink">{p.data.title}</span>
              <span class="mono-label whitespace-nowrap">{p.data.stack[0]}</span>
            </span>
            <span class="mt-1 block max-w-md text-sm leading-relaxed text-muted">{p.data.description}</span>
          </a>
        ))}
        <p class="border-t border-rule py-4 text-sm text-muted sm:col-span-2">
          More experiments and tooling —
          <a class="link" href="https://github.com/vsreddyh?tab=repositories">everything else is on GitHub ↗</a>
        </p>
      </div>
    </div>
  </section>

  <section id="about" class="border-t border-rule bg-paper-raised/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]">
      <h2 class="text-2xl">About</h2>
      <div class="max-w-[36rem] space-y-4 text-[1.0625rem] leading-[1.7] text-ink-soft">
        <p>
          I'm a software engineer in Hyderabad. Most of my work is backend and
          infrastructure: Go, Node and Python services on Postgres, ClickHouse and
          Mongo, with enough frontend to ship the thing end to end.
        </p>
        <p>
          I default to boring operations. Compose files over bespoke platforms,
          cron over always-on workers, SQLite before anything exotic. The projects
          here are mostly experiments in how much can run without me.
        </p>
        <p class="text-muted">
          Software engineer at 5th Bridge Data Technologies. B.Tech in computer
          science at KMIT, 2022–2026.
        </p>
      </div>
    </div>
  </section>

  <section id="experience" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl">Experience</h2>
      <div class="mt-8 border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-ink">Software Engineer — 5th Bridge Data Technologies</h3>
          <span class="mono-label">Jun 2026 – present</span>
        </div>
        <p class="mt-3 max-w-[38rem] text-[0.9375rem] leading-relaxed text-ink-soft">
          I work at 5th Bridge Data Technologies.
        </p>
        <p class="mt-4 text-sm">
          <a class="link" href={`${base}resume.pdf`}>Full history and education (PDF)</a>
        </p>
      </div>
    </div>
  </section>

  <section id="now" class="border-t border-rule bg-paper-raised/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-20 sm:grid-cols-[8rem_1fr]">
      <h2 class="text-2xl">Now</h2>
      <ul class="max-w-[36rem] divide-y divide-rule">
        {now.map((item) => (
          <li class="py-4 first:pt-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <a class="link font-medium" href={item.href}>{item.title}</a>
              <span class="mono-label">{item.status}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-muted">{item.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl">Get in touch</h2>
      <p class="mt-4 max-w-[34rem] text-[1.0625rem] leading-[1.7] text-ink-soft">
        Open to software engineering roles, especially teams that own their
        infrastructure and their on-call. Email is fastest.
      </p>
      <p class="mt-6">
        <a
          class="text-[clamp(1.35rem,3vw,2rem)] leading-tight text-ink underline decoration-rule decoration-1 underline-offset-4 transition hover:text-rust hover:decoration-rust"
          href="mailto:shouryanreddyh@gmail.com"
        >
          shouryanreddyh@gmail.com
        </a>
      </p>
      <p class="mono-label mt-6 flex flex-wrap gap-5">
        <a class="link" href="https://linkedin.com/in/vsreddyh">LinkedIn ↗</a>
        <a class="link" href={`${base}resume.pdf`}>Résumé (PDF)</a>
        <a class="link" href="https://github.com/vsreddyh">GitHub ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>
