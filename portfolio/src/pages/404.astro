---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="404 — Not found">
  <section class="mx-auto max-w-3xl px-4 py-32 text-center sm:px-6">
    <h1 class="text-5xl font-extrabold">404</h1>
    <p class="mt-4 text-zinc-300">That page doesn't exist.</p>
    <a href={`${base}#home`} class="mt-6 inline-block rounded-full bg-emerald-400 px-6 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-emerald-300">
      Back home
    </a>
  </section>
</BaseLayout>
