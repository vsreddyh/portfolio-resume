---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="404 — Not found">
  <section class="mx-auto max-w-3xl px-6 py-32">
    <p class="mono-label">Error 404</p>
    <h1 class="mt-4 text-5xl leading-tight">That page isn't here.</h1>
    <p class="mt-4 max-w-md text-ink-soft">The link may be old, or I may have moved something.</p>
    <p class="mt-8"><a class="btn" href={`${base}#home`}>Back home</a></p>
  </section>
</BaseLayout>
