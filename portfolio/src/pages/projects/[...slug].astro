---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mermaid from '../../components/Mermaid.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${project.data.title} — Vishnu Shouryan Reddy`} description={project.data.description}>
  <article class="mx-auto max-w-3xl px-4 pb-24 pt-28 sm:px-6">
    <a href={`${base}#work`} class="text-sm text-emerald-400 hover:text-emerald-300">← Back to selected work</a>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{project.data.title}</h1>
    <p class="mt-3 text-lg text-zinc-300">{project.data.description}</p>
    <div class="mt-5 flex flex-wrap gap-1.5">
      {project.data.stack.map((s) => (
        <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-zinc-200">{s}</span>
      ))}
    </div>
    <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold">
      {project.data.github && (
        <a href={project.data.github} class="rounded-full border border-white/20 px-5 py-2 transition hover:border-white/50 hover:bg-white/5">GitHub ↗</a>
      )}
      {project.data.demo && (
        <a href={project.data.demo} class="rounded-full bg-emerald-400 px-5 py-2 text-zinc-950 transition hover:bg-emerald-300">Live demo ↗</a>
      )}
    </div>
    <hr class="my-8 border-white/10" />
    {project.data.diagram && (
      <section aria-labelledby="architecture" class="mb-10">
        <h2 id="architecture" class="text-sm font-semibold uppercase tracking-widest text-zinc-400">Architecture</h2>
        <div class="mt-3">
          <Mermaid chart={project.data.diagram} label={`${project.data.title} architecture diagram`} />
        </div>
      </section>
    )}
    {project.data.decisions.length > 0 && (
      <section aria-labelledby="decisions" class="mb-10">
        <h2 id="decisions" class="text-sm font-semibold uppercase tracking-widest text-zinc-400">Key decisions</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          {project.data.decisions.map((d) => (
            <div class="rounded-2xl border border-white/10 bg-zinc-900/40 p-4">
              <dt class="text-sm font-semibold text-emerald-300">{d.title}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-zinc-300">{d.text}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
    <div class="prose prose-invert max-w-none prose-li:text-zinc-300 mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
